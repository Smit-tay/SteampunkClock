{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Image: build",
      "type": "shell",
      "command": "podman build -t steampunkclock_dev -f ide/Containerfile.build ide",
      "detail": "Only when ide/Containerfile.build changes"
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "./ide/cmake-in-container.sh -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release && ./ide/cmake-in-container.sh --build build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "rm -rf build"
    },
    {
      "label": "Deploy to worker",
      "type": "shell",
      "command": "cmake --build build --target deploy-spclock",
      "detail": "Host cmake (the container has no network): copies spclock and spclock.json to ~/steampunkclock on the worker. Build first"
    }
  ]
}
